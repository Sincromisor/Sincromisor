{
	"name": "sincromisor-agent-server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"build": "mastra build --studio && node preserve-dependency-overrides.mjs",
		"start": "node start.mjs",
		"check": "tsc --noEmit",
		"test": "node --import tsx --test src/mastra/__tests__/*.test.ts"
	},
	"dependencies": {
		"@mastra/core": "1.79.0",
		"@mastra/editor": "0.16.4",
		"@mastra/libsql": "1.27.0",
		"@mastra/loggers": "1.3.9",
		"@mastra/mcp": "2.5.0",
		"@mastra/memory": "1.39.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"mastra": "1.35.0",
		"tsx": "4.23.15",
		"typescript": "7.0.2"
	},
	"overrides": {
		"@mastra/mcp": {
			"@modelcontextprotocol/client": "2.4.0",
			"@modelcontextprotocol/server": "2.4.0"
		}
	}
}
