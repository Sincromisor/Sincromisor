{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": [
		"playwright.config.ts",
		"playwright.browser.ts",
		"playwright.css.config.ts",
		"playwright.rtc-integration.config.ts",
		"playwright.rtc-integration.env.ts"
	]
}
