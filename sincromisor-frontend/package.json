{
    "name": "sincromisor-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -p tsconfig.modern.json && vite build",
        "test": "vitest run",
        "generate:temporal-recovery-fixtures": "SINCRO_WRITE_RECOVERY_FIXTURES=1 vitest run src/character/motionEvaluation/fixtures/temporalArmRecoveryFixture.generate.test.ts",
        "check": "npm run check:biome && npm run check:md",
        "check:biome": "biome check .",
        "check:md": "prettier --config ../.prettierrc.json --ignore-path ../.prettierignore --check \"../*.md\" \"../.agents/CUSTOMIZATIONS.md\" \"../.agents/skills/new-task/SKILL.md\" \"../.agents/skills/run-task/SKILL.md\" \"../.claude/agents/*.md\" \"../.claude/commands/*.md\" \"../documents/**/*.md\" \"../sincromisor-server/**/*.md\" \"../tasks/**/*.md\" \"**/*.md\"",
        "format": "npm run format:biome && npm run format:md",
        "format:biome": "biome check --write .",
        "format:md": "prettier --config ../.prettierrc.json --ignore-path ../.prettierignore --write \"../*.md\" \"../.agents/CUSTOMIZATIONS.md\" \"../.agents/skills/new-task/SKILL.md\" \"../.agents/skills/run-task/SKILL.md\" \"../.claude/agents/*.md\" \"../.claude/commands/*.md\" \"../documents/**/*.md\" \"../sincromisor-server/**/*.md\" \"../tasks/**/*.md\" \"**/*.md\"",
        "preview": "vite preview"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.13",
        "@types/node": "^22.20.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.186.0",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "postcss-preset-env": "^11.5.2",
        "prettier": "^3.9.6",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "vitest": "^5.0.0"
    },
    "dependencies": {
        "@lookingglass/webxr": "^0.6.0",
        "@mediapipe/tasks-vision": "^1.0.1",
        "@pixiv/three-vrm": "^3.5.5",
        "hls.js": "^1.7.3",
        "onnxruntime-web": "^1.29.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "three": "^0.186.0",
        "zod": "^4.6.2"
    }
}
