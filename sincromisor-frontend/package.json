{
    "name": "sincromisor-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "assets:prepare": "node scripts/prepare-mediapipe-assets.js",
        "dev": "npm run assets:prepare && vite",
        "build": "npm run assets:prepare && tsc -p tsconfig.modern.json && vite build",
        "test": "vitest run",
        "generate:temporal-recovery-fixtures": "SINCRO_WRITE_RECOVERY_FIXTURES=1 vitest run src/character/motionEvaluation/fixtures/temporalArmRecoveryFixture.generate.test.ts",
        "check": "npm run check:biome",
        "check:biome": "biome check .",
        "format": "npm run format:biome",
        "format:biome": "biome check --write .",
        "preview": "vite preview"
    },
    "devDependencies": {
        "@csstools/postcss-cascade-layers": "^6.0.2",
        "@csstools/postcss-is-pseudo-class": "^6.0.3",
        "@csstools/postcss-system-ui-font-family": "^2.0.3",
        "@csstools/postcss-text-decoration-shorthand": "^5.0.7",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.186.0",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "autoprefixer": "^10.6.1",
        "postcss": "^8.5.31",
        "postcss-clamp": "^4.1.0",
        "postcss-color-functional-notation": "^8.0.15",
        "postcss-color-hex-alpha": "^11.0.1",
        "postcss-custom-properties": "^15.0.4",
        "postcss-font-variant": "^5.0.0",
        "postcss-gap-properties": "^7.0.0",
        "postcss-logical": "^9.0.2",
        "postcss-nesting": "^14.0.3",
        "postcss-place": "^11.0.1",
        "postcss-replace-overflow-wrap": "^4.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@lookingglass/webxr": "^0.6.0",
        "@mediapipe/tasks-vision": "^1.1.1",
        "@pixiv/three-vrm": "^3.5.5",
        "hls.js": "^1.7.3",
        "onnxruntime-web": "^1.30.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "three": "^0.186.1",
        "zod": "^4.6.7"
    }
}
