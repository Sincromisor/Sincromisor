{
    "name": "sincromisor-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "assets:prepare": "node scripts/prepare-mediapipe-assets.js",
        "dev": "npm run assets:prepare && vite",
        "build": "npm run assets:prepare && tsc -p tsconfig.modern.json && vite build",
        "test": "vitest run",
        "generate:temporal-recovery-fixtures": "SINCRO_WRITE_RECOVERY_FIXTURES=1 vitest run src/character/motionEvaluation/fixtures/temporalArmRecoveryFixture.generate.test.ts",
        "check": "npm run check:biome",
        "check:biome": "biome check .",
        "format": "npm run format:biome",
        "format:biome": "biome check --write .",
        "preview": "vite preview"
    },
    "devDependencies": {
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.186.0",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "postcss-preset-env": "^11.6.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.3",
        "vitest": "^5.0.3"
    },
    "dependencies": {
        "@lookingglass/webxr": "^0.6.0",
        "@mediapipe/tasks-vision": "^1.0.1",
        "@pixiv/three-vrm": "^3.5.5",
        "hls.js": "^1.7.3",
        "onnxruntime-web": "^1.30.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "three": "^0.186.1",
        "zod": "^4.6.5"
    }
}
