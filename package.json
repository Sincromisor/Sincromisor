{
    "name": "sincromisor",
    "private": true,
    "type": "module",
    "taskBranchPrefix": "codex/",
    "scripts": {
        "tasks:new": "node scripts/tasks/newTask.mjs",
        "tasks:set": "node scripts/tasks/setMeta.mjs",
        "tasks:index": "node scripts/tasks/genIndex.mjs",
        "tasks:index:check": "node scripts/tasks/genIndex.mjs --check",
        "tasks:reindex": "node scripts/tasks/reindex.mjs",
        "tasks:check": "node scripts/tasks/checkTasks.mjs",
        "tasks:check:frontend-structure": "node scripts/tasks/checkFrontendStructure.mjs",
        "tasks:fixlinks": "node scripts/tasks/fixLinks.mjs",
        "tasks:migrate:legacy": "node scripts/tasks/migrateLegacyTasks.mjs",
        "tasks:migrate:reviewed-sha": "node scripts/tasks/migrateReviewedSha.mjs",
        "gate": "node scripts/gate/gate.mjs",
        "tasks:close": "node scripts/tasks/closeTask.mjs",
        "tasks:metrics": "node scripts/tasks/metrics.mjs",
        "eval:worktree": "node scripts/eval/setupWorktree.mjs",
        "tasks:next": "node scripts/tasks/nextTasks.mjs",
        "gen:codex": "node scripts/gen/genCodex.mjs",
        "gen:codex:check": "node scripts/gen/genCodex.mjs --check",
        "git:hooks:install": "git config core.hooksPath .githooks",
        "commit:check": "node scripts/git/checkCommitMessage.mjs",
        "dev": "npm run dev --workspace sincromisor-frontend --",
        "build": "npm run build --workspace sincromisor-frontend --",
        "test": "npm run test --workspace sincromisor-frontend --",
        "assets:prepare": "npm run assets:prepare --workspace sincromisor-frontend --",
        "check": "npm run check --workspace sincromisor-frontend && npm run check:md",
        "check:md": "prettier --config .prettierrc.json --ignore-path .prettierignore --check \"*.md\" \".agents/CUSTOMIZATIONS.md\" \".agents/skills/new-task/SKILL.md\" \".agents/skills/run-task/SKILL.md\" \".claude/agents/*.md\" \".claude/commands/*.md\" \"documents/**/*.md\" \"sincromisor-server/**/*.md\" \"tasks/**/*.md\" \"sincromisor-frontend/**/*.md\" \"utils/**/*.md\"",
        "format": "npm run format --workspace sincromisor-frontend && npm run format:md",
        "format:md": "prettier --config .prettierrc.json --ignore-path .prettierignore --write \"*.md\" \".agents/CUSTOMIZATIONS.md\" \".agents/skills/new-task/SKILL.md\" \".agents/skills/run-task/SKILL.md\" \".claude/agents/*.md\" \".claude/commands/*.md\" \"documents/**/*.md\" \"sincromisor-server/**/*.md\" \"tasks/**/*.md\" \"sincromisor-frontend/**/*.md\" \"utils/**/*.md\"",
        "preinstall": "node scripts/check-node-version.mjs",
        "check:runtime": "node scripts/check-node-version.mjs",
        "browser": "playwright-cli",
        "browser:install": "PLAYWRIGHT_BROWSERS_PATH=./work/playwright-browsers playwright install chromium",
        "browser:test": "PLAYWRIGHT_BROWSERS_PATH=./work/playwright-browsers playwright test"
    },
    "codexGen": {
        "modelMap": {
            "opus": "gpt-5.6-terra"
        },
        "hookCommand": "node scripts/metrics/logAgentRun.mjs"
    },
    "taskClose": {
        "commitTemplate": "タスクの最終判定を{verdict}（試行{attempts}回）として記録し、成果物を同期した。`npm run tasks:check`で確認し、残る判断事項は`{taskDir}/eval.md`と`{taskDir}/impl.md`を参照する。\n\nRefs: {id}"
    },
    "gateSteps": [
        {
            "id": "lint",
            "cmd": "npm run check",
            "label": "frontend lint/format and Markdown check"
        },
        {
            "id": "build",
            "cmd": "npm run build",
            "label": "frontend type check and build"
        },
        {
            "id": "test",
            "cmd": "npm run test",
            "label": "frontend tests"
        }
    ],
    "evalWorktree": {
        "symlinks": [
            "node_modules",
            ".gate-cache"
        ],
        "copies": [
            ".env",
            "sincromisor-frontend/.env"
        ]
    },
    "dependencies": {
        "yaml": "^2.5.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@playwright/cli": "0.1.22",
        "@playwright/test": "1.63.0",
        "prettier": "^3.9.9"
    },
    "workspaces": [
        "sincromisor-frontend"
    ],
    "engines": {
        "node": "26.11.1",
        "npm": "11.20.0"
    },
    "packageManager": "npm@11.20.0"
}
