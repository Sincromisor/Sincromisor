# リポジトリのルートへ .env としてコピーし、起動前に広告IPv4などを編集する。
# 通常は全サービスを起動する。分散配置ではホストの担当に合わせてbackend、rtcなどへ変更する。
COMPOSE_PROFILES=full
# COMPOSE_FILEはDocker Composeが読み、指定順にファイルを結合する（Linuxでは:区切り）。
# 単一ホストの標準構成: HTTPとメディアUDPだけを公開する。
COMPOSE_FILE=compose.yml
# 分散配置: 別ホストのRTC向けに下流APIとConsulのホスト間通信を管理IPへ公開する。
# COMPOSE_FILE=compose.yml:compose/distributed.yml
# ホスト側のHTTPS終端・保守接続も使う場合: RTC HTTPとConsul管理APIをループバックへ追加する。
# COMPOSE_FILE=compose.yml:compose/distributed.yml:compose/management.yml
# 単一ホストで管理接続だけを追加する場合:
# COMPOSE_FILE=compose.yml:compose/management.yml
# 上の有効なCOMPOSE_FILE行を用途に合わせて置き換え、docker compose up -dで反映する。
# 分散配置では下記SINCRO_CONSUL_PUBLISH_HOSTと広告先・サービス登録先も管理IPに合わせる。
# 起動対象はCOMPOSE_PROFILESで選ぶ。VPSのRTC専用ホストはrtcを指定する。
# 詳細: documents/design/infrastructure/compose.md「公開ポートの選択」

# ホスト
# buildしたコンテナイメージをローカルレジストリにpushしたい場合は、
# レジストリサーバーホスト名:ポート番号 にする
# 例: 127.0.0.1:5000
SINCRO_REGISTRY_NAME=ghcr.io/sincromisor

# compose network
SINCRO_COMPOSE_NETWORK_SUBNET=172.28.0.0/16

# consul-server
SINCRO_CONSUL_SERVER_HOST=sincro-consul-server
SINCRO_CONSUL_SERVER_NODE_NAME=server01
# 全メンバーが到達できる管理IPv4。空欄ではConsulが自動選択する。
SINCRO_CONSUL_ADVERTISE_ADDR=
# distributed.ymlのRTC・下流API・Consulの公開先。分散配置時は管理IPv4を必ず指定する。
SINCRO_CONSUL_PUBLISH_HOST=
# 単一サーバーの検証環境向けに停止許容期間を10年へ延長する。複数サーバーでは168hへ戻す。
SINCRO_CONSUL_SERVER_REJOIN_AGE_MAX=87600h

# consul-agent
# SINCRO_CONSUL_AGENT_HOSTは原則として空欄とする
SINCRO_CONSUL_AGENT_HOST=
SINCRO_CONSUL_AGENT_PORT=8500

# redis(voice cache)
SINCRO_REDIS_HOST=sincro-redis
SINCRO_REDIS_PORT=6379

# Pion sincro-rtc
SINCRO_RTC_MAX_SESSIONS=10
SINCRO_PION_MEDIA_UDP_PORT=3479
SINCRO_PION_INTERFACE=eth0
# ブラウザから到達できるサーバーホストのIPv4へ必ず置き換える。
# 閉じたLANではホストのLANアドレスを使う。以下は例示値で、公開IPは必須ではない。
SINCRO_PION_PUBLIC_IPV4=203.0.113.10
# 以下は外部STUN。閉じたLANで直接UDP通信できる場合は空指定にできる。
# 空指定でも広告IPv4とメディアUDPポートへの到達性は必要。TURNは未対応。
SINCRO_PION_STUN=stun:stun.l.google.com:19302
SINCRO_PION_FFMPEG_PATH=/usr/bin/ffmpeg
# Pionは同一ホストのconsul-agent-rtcから下流serviceを解決し、自身を登録する。
# HTTP 8500はホストへ公開しない。単一ホストではサービス名、分散配置では管理IPv4を指定する。
SINCRO_PION_SERVICE_BIND_HOST=sincro-rtc

# speech-extractor
SINCRO_EXTRACTOR_HOST=0.0.0.0
SINCRO_EXTRACTOR_PORT=8002
SINCRO_EXTRACTOR_PUBLIC_BIND_HOST=speech-extractor
SINCRO_EXTRACTOR_PUBLIC_BIND_PORT=8002

# speech-recognizer
SINCRO_RECOGNIZER_HOST=0.0.0.0
SINCRO_RECOGNIZER_PORT=8003
SINCRO_RECOGNIZER_PUBLIC_BIND_HOST=speech-recognizer
SINCRO_RECOGNIZER_PUBLIC_BIND_PORT=8003
SINCRO_RECOGNIZER_VOICE_LOG_DIR=/opt/sincromisor/.voice
SINCRO_RECOGNIZER_PROPER_NOUN_ENABLE=false
# 例: /opt/sincromisor/proper-noun-dictionaries/proper_nouns.csv
SINCRO_RECOGNIZER_PROPER_NOUN_DICT_PATH=
SINCRO_RECOGNIZER_PROPER_NOUN_CONTEXT_BIASING_ENABLE=false
SINCRO_RECOGNIZER_PROPER_NOUN_CONTEXT_BIASING_BEAM_SIZE=4
SINCRO_RECOGNIZER_PROPER_NOUN_NBEST_ENABLE=false
SINCRO_RECOGNIZER_PROPER_NOUN_NBEST_BEAM_SIZE=4
# 音声認識モデルはnemoのみ対応。VRAM 4GB程度が必要。
# 認識サービスが欠損時だけ自動取得する。volumes/sincro-cacheは初回のみUID 1001で作成する。
# nemo: https://huggingface.co/reazon-research/reazonspeech-nemo-v2
SINCRO_RECOGNIZER_MODEL=nemo

# text-processor
SINCRO_PROCESSOR_HOST=0.0.0.0
SINCRO_PROCESSOR_PORT=8004
SINCRO_PROCESSOR_PUBLIC_BIND_HOST=text-processor
SINCRO_PROCESSOR_PUBLIC_BIND_PORT=8004

# chatには管理下のDifyとLLMが必要。text-processorコンテナから到達できるURLを指定する。
# 例: http://192.168.1.20/v1 （配置先のLANアドレス・ポートへ置き換える）
# 127.0.0.1はこのコンテナ自身であり、別ホストや別コンテナのDifyを指さない。
# sincroはDify不要。空欄で試す場合は、ブラウザの開始前に既定chatからsincroへ変更する。
SINCRO_PROCESSOR_DIFY_URL=
# app-xxxxxxxxxxxxxxxxxxxxxxxx
SINCRO_PROCESSOR_DIFY_TOKEN=

# voice-synthesizer
SINCRO_SYNTHESIZER_HOST=0.0.0.0
SINCRO_SYNTHESIZER_PORT=8005
SINCRO_SYNTHESIZER_PUBLIC_BIND_HOST=voice-synthesizer
SINCRO_SYNTHESIZER_PUBLIC_BIND_PORT=8005
SINCRO_SYNTHESIZER_VOICEVOX_DEFAULT_STYLE_ID=0

# VOICEVOX
SINCRO_VOICEVOX_HOST=0.0.0.0
SINCRO_VOICEVOX_PORT=50021

# S3
SINCRO_S3_PUBLIC_BIND_HOST=sincro-s3
SINCRO_S3_PUBLIC_BIND_PORT=8333
SINCRO_S3_CONSOLE_PUBLIC_BIND_PORT=9001
SINCRO_S3_ACCESS_KEY=sincromisor
SINCRO_S3_SECRET_KEY=SINCROMISOR_S3_ROOT_PASSWORD
